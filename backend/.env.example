# ==========================================
# HOLIDO PAYMENT GATEWAY CONFIGURATION
# ==========================================

# Active Gateway Provider: 'RAZORPAY' | 'CASHFREE' | 'PHONEPE'
PAYMENT_GATEWAY_PROVIDER=RAZORPAY
PAYMENT_MODE=TEST # 'TEST' or 'LIVE'

# ------------------------------------------
# 1. RAZORPAY (Rider Collections & Webhooks)
# Get credentials from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# ------------------------------------------
# 2. CASHFREE (Instant Captain Daily Payouts)
# Get credentials from: https://merchant.cashfree.com/
# ------------------------------------------
CASHFREE_APP_ID=cf_app_YourCashfreeAppIdHere
CASHFREE_SECRET_KEY=cf_sec_YourCashfreeSecretKeyHere
CASHFREE_API_VERSION=2023-08-01

# ------------------------------------------
# 3. CASH & WALLET POLICY
# ------------------------------------------
ENABLE_CASH_PAYMENTS=true
# Maximum cash commission deficit a Captain can carry before being blocked from taking rides
CAPTAIN_MAX_CASH_DEBT_LIMIT=500.00
# Automatic Captain Payout trigger: 'DAILY_MIDNIGHT' | 'ON_DEMAND'
CAPTAIN_PAYOUT_TRIGGER=DAILY_MIDNIGHT

# ------------------------------------------
# 0. SUPER ADMIN ROOT CREDENTIALS
# ------------------------------------------
SUPER_ADMIN_USERNAME=admin_holido
SUPER_ADMIN_EMAIL=admin@holido.in
SUPER_ADMIN_PASSWORD=HolidoSuperSecret2026#
SUPER_ADMIN_SECURITY_PIN=482910
JWT_SECRET=holido_jwt_ultra_secure_token_secret_2026

# ------------------------------------------
# 4. SERVER CONFIG
# ------------------------------------------
PORT=4000
NODE_ENV=development
